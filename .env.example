# Copy to .env.local and fill in. Never commit real values (.gitignore covers .env*).
# Source/rationale for each key: docs/05-api-integration-guide.md

# --- Database (Neon Postgres, via Vercel Marketplace) ---
DATABASE_URL=

# --- Redis (Upstash, via Vercel Marketplace) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth.js ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# --- Cesium ion (terrain streaming) ---
# Client-exposed by design — scoped, low-privilege token. See docs/10-security-guide.md 10.3.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# --- NASA FIRMS (wildfires) — firms.modaps.eosdis.nasa.gov/api/map_key ---
FIRMS_MAP_KEY=

# --- NASA APIs (DONKI, EPIC, APOD, NeoWs) — api.nasa.gov ---
NASA_API_KEY=

# --- OpenAQ (air quality station data) — explore.openaq.org ---
OPENAQ_API_KEY=

# --- GeoNames (timezone-by-coordinate) — geonames.org ---
GEONAMES_USERNAME=

# --- Nominatim (geocoding) ---
# No key; a descriptive User-Agent/Referer is required by policy instead.
NOMINATIM_USER_AGENT="EarthLive/1.0 (contact@example.com)"

# --- OpenSky Network (registered OAuth2 client) — opensky-network.org/my-opensky ---
# Optional: bumps the anonymous ~400 credits/day quota to ~4000/day.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Error tracking: GlitchTip (glitchtip.com) ---
# Sentry-protocol compatible, MIT licensed, free tier = 1,000 events/month.
# The @sentry/nextjs SDK is kept; only the DSN points elsewhere.
# Create a project at app.glitchtip.com, then paste its DSN into both:
#   - GLITCHTIP_DSN            server + edge runtimes (never sent to the browser)
#   - NEXT_PUBLIC_GLITCHTIP_DSN  browser runtime (public by necessity)
# Leave both empty to disable error reporting entirely.
GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_DSN=

# --- Analytics: Cloudflare Web Analytics ---
# Free with no event cap, no cookies, no consent banner needed. The site does
# NOT need to be proxied through Cloudflare DNS. Get the token from the
# Cloudflare dashboard -> Web Analytics -> Manage site. Leave empty to disable
# analytics entirely (no third-party script is loaded).
NEXT_PUBLIC_CF_BEACON_TOKEN=
