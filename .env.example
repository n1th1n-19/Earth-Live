# Copy to .env.local and fill in. Never commit real values (.gitignore covers .env*).
# Source/rationale for each key: docs/05-api-integration-guide.md

# --- Database (Neon Postgres, via Vercel Marketplace) ---
DATABASE_URL=

# --- Redis (Upstash, via Vercel Marketplace) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth.js ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# --- Cesium ion (terrain streaming) ---
# Client-exposed by design — scoped, low-privilege token. See docs/10-security-guide.md 10.3.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# --- NASA FIRMS (wildfires) — firms.modaps.eosdis.nasa.gov/api/map_key ---
FIRMS_MAP_KEY=

# --- NASA APIs (DONKI, EPIC, APOD, NeoWs) — api.nasa.gov ---
NASA_API_KEY=

# --- OpenAQ (air quality station data) — explore.openaq.org ---
OPENAQ_API_KEY=

# --- GeoNames (timezone-by-coordinate) — geonames.org ---
GEONAMES_USERNAME=

# --- Nominatim (geocoding) ---
# No key; a descriptive User-Agent/Referer is required by policy instead.
NOMINATIM_USER_AGENT="EarthLive/1.0 (contact@example.com)"

# --- OpenSky Network (registered OAuth2 client) — opensky-network.org/my-opensky ---
# Optional: bumps the anonymous ~400 credits/day quota to ~4000/day.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Sentry ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Google Analytics 4 (optional) ---
# Measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics
# entirely — src/components/Analytics.tsx renders nothing and loads no
# third-party script when this is unset.
NEXT_PUBLIC_GA_ID=
