# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real secrets)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor/OS
.remember/

/src/generated/prisma

# cesium static assets, regenerated by scripts/copy-cesium-assets.mjs
/public/cesium

# Sentry Config File
.env.sentry-build-plugin

# per-editor agent-skill scaffolding generated by `prisma init`
/.claude/skills
/.agents
/.windsurf
/skills-lock.json

# browser-testing artifacts (Playwright MCP screenshots/console logs)
/.playwright-mcp
